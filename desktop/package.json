{
  "name": "atmosphaerenlabor",
  "version": "1.1.3",
  "description": "Atmosphärenlabor für Windows",
  "author": "Elexerion",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test ../tests/desktop.test.cjs ../tests/frontend.test.cjs",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "dependencies": {"electron-updater": "6.8.11"},
  "build": {
    "appId": "de.atmosphaere.labor",
    "productName": "AtmosphaerenLabor",
    "files": ["main.cjs", "sounding.cjs", "smoke.cjs", "package.json"],
    "extraResources": [{"from": "../app/src/main/assets", "to": "assets"}],
    "win": {"target": ["nsis", "portable"], "signExecutable": false},
    "nsis": {"oneClick": true, "perMachine": false, "artifactName": "AtmosphaerenLabor-${version}-Setup-x64.${ext}"},
    "publish": [{"provider": "github", "owner": "Elexerion", "repo": "AtmosphaerenLabor"}],
    "artifactName": "AtmosphaerenLabor-${version}-Windows-x64.${ext}",
    "directories": {"output": "dist"}
  }
}
